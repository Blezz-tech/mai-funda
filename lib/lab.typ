// ============================================================
//  Шаблон отчёта по лабораторной работе (МАИ, каф. 806,
//  «Фундаментальная информатика»)
// ------------------------------------------------------------
//  Публичный API — всего три функции:
//
//    #show: setup.with()          страница, шрифты, поля
//    #report(...)                 весь отчёт (пункты 1–11)
//    #console("/lr/1/src/session1.txt")
//                                 вывод консоли / листинг из .txt:
//                                 моноширинный текст на сером фоне,
//                                 как скопировано из терминала
//
//  Всё общее (шапка, пункты 1–11, оборудование, ПО, дневник,
//  подпись) живёт здесь. В main.typ работы — только содержимое:
//  тема, цель, задание, пункты 6–8 и строки дневника.
//
//  Консоль, тесты, исходники — это просто .txt-файлы. Никаких
//  test-case / protocol / listing с массивами и ручными отступами:
//  файл копируется из терминала как есть и подключается одной
//  строкой #console(...).
// ============================================================


// ------------------------------------------------------------
//  Глобальные переменные
// ------------------------------------------------------------

#let doc-meta = (
  student: "Маркусь Евгений Олегович",
  teacher: box[#highlight[каф. 806 Никулин Сергей Петрович]],
  group: "М8О-113БВ-26",
  list-no: "17",
  contacts: "markus.jenya04@yandex.ru",
);

// ------------------------------------------------------------
//  Глобальные настройки страницы и текста
// ------------------------------------------------------------
#let setup(
  doc,
  body-font: (
    "Times New Roman",
    "Liberation Serif",
    "DejaVu Serif",
  ),
  mono-font: (
    "Hack",
    "Liberation Mono",
    "DejaVu Sans Mono",
  ),
) = {
  set page(
    paper: "a4",
    margin: (top: 2cm, bottom: 2cm, left: 3cm, right: 1.5cm),
  )
  set text(font: body-font, size: 12pt, lang: "ru", hyphenate: true)
  set par(justify: true, leading: 0.4em, spacing: 0.4em, first-line-indent: 0pt)
  set table(stroke: 0.5pt)
  show table.cell: it => {
    set text(size: 8pt)
    set par(justify: false, leading: 0.4em)
    align(center + horizon, it)
  }
  // моноширинные блоки (консоль): плотный интерлиньяж,
  // длинные строки переносятся по правому краю текста
  show raw.where(block: true): it => {
    set text(font: mono-font, size: 8pt, lang: "en", hyphenate: false)
    set par(justify: false, leading: 0.34em, spacing: 0.34em)
    block(width: 100%, inset: 0pt, above: 0.6em, below: 0.6em, it)
  }
  show raw.where(block: false): it => text(font: mono-font, size: 0.92em, it)
  doc
}

// ------------------------------------------------------------
//  Текст из .txt-файла: вывод консоли, листинг, тесты.
//  Путь задаётся от корня проекта (например
//  "/lr/2/src/tests.txt"). Файл читается как есть и печатается
//  моноширинным шрифтом на светло-сером фоне — как скопировано
//  из терминала. Никаких массивов строк и ручных отступов.
// ------------------------------------------------------------
#let console(path, size: 8pt, lang: "text") = {
  let content = read(path).replace("\t", "    ")
  block(
    width: 100%,
    fill: rgb("#f2f2f2"),
    inset: 6pt,
    stroke: 0.4pt + rgb("#cccccc"),
    text(font: "Hack", size: size, lang: "en", hyphenate: false)[
      #raw(content, block: true, lang: lang)
    ],
  )
}

// ------------------------------------------------------------
//  Внутренние помощники (не часть публичного API)
// ------------------------------------------------------------

// нумерованный пункт отчёта: «1. Тема: …»
#let _item(num, head, body, annotation: none) = block(
  if annotation == none {
    [*#num* *#head* #body]
  } else {
    [*#num* *#head* #emph(annotation) #block(body)]
  },
)

// список «оборудование / ПО» с отступом.
// Точка в конце автоматически добавляется к последнему пункту.
#let _indented-list(items) = block(
  inset: (left: 1.25cm),
  items.enumerate().map(((i, it)) => [#it #if i != items.len() { [\ ] }]).join()
)

// дневник отладки: 7 колонок, как в исходных ODT
#let _diary(rows) = align(center)[
  #table(
    columns: (0.6cm, 1.4cm, 1.5cm, 1.2cm, auto, auto, auto),
    align: center + horizon,
    stroke: 0.5pt,
    table.header([№], [Лаб. или дом.], [Дата], [Время], [Событие], [Действие по исправлению], [Примечание]),
    ..rows.map(r => r.map(c => [#c])).flatten(),
  )
]

// ------------------------------------------------------------
//  Общие списки для всех лабораторных работ; правятся здесь.
// ------------------------------------------------------------
#let default-equipment = (
  "Процессор Intel® Core™ i5-12400F",
  "ОП 32 ГБ",
  "SSD 1 ТБ",
  "Монитор 23.8\" AOC 24G2SAE/BK черный",
)

#let default-software = (
  "Операционная система семейства Unix подсемейство Linux",
  "Наименование NixOS версия 26.11",
  "Интерпретатор команд zsh версия 5.9.2 (x86_64-pc-linux-gnu)",
  "Система программирования gcc версия 16.2.0",
  "Редактор текстов vscode версия 1.144.0",
)

// ------------------------------------------------------------
//  Отчёт целиком: общая структура пунктов 1–11.
//  В main.typ работы остаётся только содержимое.
// ------------------------------------------------------------
#let report(
  // номер лабораторной работы (строка, например "1" или "2 (8)")
  number: "1",
  // содержимое пунктов
  topic: none, // 1. Тема
  goal: none, // 2. Цель работы
  task: none, // 3. Задание
  idea: none, // 6. Идея, метод, алгоритм, решение задачи
  scenario: none, // 7. Сценарий выполнения работы
  protocol: none, // 8. Распечатка протокола
  diary-rows: (), // 9. Дневник отладки (строки таблицы)
  comments: [ замечания отсутствуют.], // 10. Замечания автора
  conclusion: none, // 11. Вывод
  // реквизиты шапки (по умолчанию — как в ODT-исходниках)
  done: "«__» __________ 202_ г.",
  handed: "«__» __________ 202_ г.",
  // необщие строки ПО, добавляются к общему списку
  software-extra: (),
) = {
  // шапка ЛР: заголовок по центру, реквизиты с отступом слева
  {
    align(center, text(weight: "bold")[
      Отчёт по лабораторной работе № #number по курсу «Фундаментальная информатика».
    ])
    v(0.35em)
    block(inset: (left: 1.25cm), text[
      Студент группы #doc-meta.group #doc-meta.student № по списку #doc-meta.list-no.
    ])
    v(0.35em)
    block(inset: (left: 7cm), [
      Контакты: #doc-meta.contacts \
      Работа выполнена: #done \
      Преподаватель: #doc-meta.teacher \
      Входной контроль знаний с оценкой: \_\_\_\_\_ \
      Отчет сдан #handed \
      Итоговая оценка: \_\_\_\_\_ \
      Подпись преподавателя: \_\_\_\_\_\_\_\_\_\_
    ])
    v(0.7em)
  }
  _item("1.", "Тема:", topic)
  _item("2.", "Цель работы:", goal)
  _item("3.", "Задание:", task)
  _item("4.", "Оборудование:", _indented-list(default-equipment),
  annotation: [Оборудование ПЭВМ студента:])
  _item("5.", "Программное обеспечение:", _indented-list(default-software + software-extra),
  annotation: [Программное обеспечение ПЭВМ студента:]
  )
  _item("6.", "Идея, метод, алгоритм, решение задачи", idea,
  annotation:[[в формах: словесной, псевдокода, графической (блок-схема, диаграмма,
    рисунок, таблица) или формальные спецификации с пред- и постусловиями]:])
  _item("7.", "Сценарий выполнения работы",  scenario, annotation:[\[(план работы, 
  первоначальный текст программы в черновике (можно на отдельном листе) и
  тесты либо соображения по тестированию).\]   ])
  v(1em)
  emph[Пункты 1–7 отчета составляются строго до начала лабораторной работы.]
  v(1em)
  align(right)[
    #emph[Допущен к выполнению работы.] #strong[Подпись преподавателя] \_\_\_\_\_\_\_\_\_\_\_\_\_\_\_
  ]
  pagebreak()
  _item("8.", "Распечатка протокола", protocol, annotation:[
    [(подклеить листинг окончательного варианта программы с тестовыми
    примерами, подписанный преподавателем)].
  ])
  _item("9.", "Дневник отладки", _diary(diary-rows), annotation:[
    [должен содержать дату и время сеансов отладки и основные события
    (ошибки в сценарии и программе, нестандартные ситуации) и краткие
    комментарии к ним. В дневнике отладки приводятся сведения об
    использовании других ЭВМ, существенном участии преподавателя и других
    лиц в написании и отладке программы.]
  ])
  _item("10.", "Замечания автора по существу работы:", comments)
  _item("11.", "Вывод:", conclusion)
  v(2.5em)
  align(right)[Подпись студента \_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_]
}
